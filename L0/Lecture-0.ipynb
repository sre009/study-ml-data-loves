    "import sys\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "print(sys.version)\n",
    "print(sys.executable)\n",
    "\n",
    "df = pd.DataFrame({\"x\": [1, 2, 3, 4], \"y\": [1, 4, 9, 16]})\n",
    "display(df)\n",
    "\n",
    "df.plot(x=\"x\", y=\"y\", marker=\"o\", title=\"y = x²\")\n",
    "plt.show()"
   ]
